# Copy to .env for local development. On Render, set these in the dashboard.

APP_ENV=development

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Local default is SQLite. In production use PostgreSQL, e.g.
#   postgresql://user:password@host:5432/nova
DATABASE_URL=sqlite:///./nova.db

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,https://albimaria.github.io

# Optional overrides
# NOVA_MODEL_FAST=gemini-3.5-flash-lite
# NOVA_MODEL_STANDARD=gemini-3.5-flash
# NOVA_MODEL_REASONING=gemini-3.5-flash
# NOVA_THINKING_REASONING=HIGH
# NOVA_WEB_SEARCH_ENABLED=false   # needs a paid Gemini plan
# NOVA_RATE_LIMIT_PER_MINUTE=10
# NOVA_RATE_LIMIT_PER_DAY=200
